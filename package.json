{
  "name": "trading-dashboard-fullstack",
  "version": "1.0.0",
  "description": "Fullstack trading dashboard with React frontend and Node.js backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "python canuck-trader-pro/backend/main.py",
    "start:node": "node server.js",
    "dev": "concurrently \"python canuck-trader-pro/backend/main.py\" \"vite\"",
    "dev:node": "concurrently \"node server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.378.0",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.12.7",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.7",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
