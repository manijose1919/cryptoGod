[Unit]
Description=Canuck Trader Pro - Node.js Trading Engine
After=network.target

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/trading-bot
ExecStart=/usr/bin/node --experimental-strip-types serverV2.ts
Restart=always
RestartSec=5
EnvironmentFile=/opt/trading-bot/.env

[Install]
WantedBy=multi-user.target
