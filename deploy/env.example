# ============================================
# Trading Bot Environment Variables
# Copy this to .env and fill in your keys
# ============================================

# Crypto.com Exchange API (get from https://crypto.com/exchange)
SESSION_API_KEY="your_api_key_here"
SESSION_SECRET_KEY="your_secret_key_here"

# Gemini AI (for pre-trade AI gating)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_key_here"

# TradingView Webhook Secret (random string for webhook auth)
TRADINGVIEW_WEBHOOK_SECRET="your_webhook_secret_here"

# Server Config (usually leave defaults)
# PORT=3033
# CORS_ORIGIN=http://localhost:3000
# NODE_ENV=production
